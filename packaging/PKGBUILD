# Maintainer: SattNEK
pkgname=git2pkg
_tag=v0.2.0-alpha.4
pkgver=0.2.0alpha4
pkgrel=1
pkgdesc="Isolated package builder from Git repositories for Linux distributions"
arch=('x86_64')
url="https://github.com/hyalcin70/git2pkg"
license=('GPL-3.0-or-later')
depends=('libxkbcommon' 'wayland' 'libxcb' 'libxrandr' 'libxi' 'libxcursor' 'mesa' 'hicolor-icon-theme')
makedepends=('rust' 'cargo' 'pkgconf' 'libxkbcommon' 'mesa' 'wayland' 'libxcb' 'libxrandr' 'libxi' 'libxcursor')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/$_tag.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$srcdir/$pkgname-${_tag#v}"
  cargo build --release --locked
}

package() {
  cd "$srcdir/$pkgname-${_tag#v}"
  install -Dm755 "${CARGO_TARGET_DIR:-target}/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  # Primäres Programm-Icon des Projekts.
  install -Dm644 assets/app_icon.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/$pkgname.png"
  install -Dm644 assets/app_icon.png "$pkgdir/usr/share/pixmaps/$pkgname.png"

  install -Dm644 packaging/git2pkg.desktop "$pkgdir/usr/share/applications/git2pkg.desktop"

  # Desktop- und Icon-Dateien liegen je nach Projekt in assets/ oder packaging/.
  for f in assets/*.desktop packaging/*.desktop; do
    [ -f "$f" ] || continue
    install -Dm644 "$f" "$pkgdir/usr/share/applications/$(basename "$f")"
  done
  for f in assets/*.svg packaging/*.svg; do
    [ -f "$f" ] || continue
    install -Dm644 "$f" "$pkgdir/usr/share/icons/hicolor/scalable/apps/$(basename "$f")"
  done
  for f in assets/*.png packaging/*.png assets/*.ico packaging/*.ico; do
    [ -f "$f" ] || continue
    case "$f" in assets/app_icon.png) continue ;; esac
    install -Dm644 "$f" "$pkgdir/usr/share/pixmaps/$(basename "$f")"
  done
  for f in assets/*.png packaging/*.png; do
    [ -f "$f" ] || continue
    case "$f" in assets/app_icon.png) continue ;; esac
    install -Dm644 "$f" "$pkgdir/usr/share/icons/hicolor/256x256/apps/$(basename "$f")"
  done
}
